---
import { getCollection } from "astro:content";
import ProjectPreview from "../components/ProjectPreview.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../utils/site-path";

const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER));
---

<SiteLayout
  title="Senior product designer & design leader"
  description="Portfolio of a senior product designer and design leader working across automotive interfaces, digital products, and design systems."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__topline">
      <p class="eyebrow">Automotive interfaces <span aria-hidden="true">/</span> Digital products</p>
      <p class="eyebrow">Senior product designer <span aria-hidden="true">·</span> Design leader</p>
    </div>
    <h1 class="home-hero__title" id="home-title">
      From interface detail to product direction.
    </h1>
    <div class="home-hero__bottom">
      <p class="home-hero__lede">
        12 years of UI/UX design experience, bringing clarity to complex interfaces, products, and
        the teams behind them.
      </p>
      <a class="text-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="work-section" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work <span aria-hidden="true">/</span> {projects.length} projects</p>
        <h2 class="section-title" id="work-title">A few things, made considered.</h2>
      </div>
      <p class="section-heading__note">
        Fictional concept studies / placeholder artwork
      </p>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectPreview project={project} index={index} />)}
    </div>
  </section>

  <section class="about-strip" id="about" aria-labelledby="about-title">
    <p class="eyebrow">A little about how I work</p>
    <div>
      <h2 class="section-title" id="about-title">Good design makes room for clarity.</h2>
      <p>
        I bring a designer’s eye and a team leader’s perspective to complex product challenges,
        connecting detail, systems, and the people who use them.
      </p>
      <a class="text-link" href={sitePath("about/")}>More about my practice <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="contact-panel" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">Have something in mind?</p>
    <div>
      <h2 class="contact-panel__title" id="contact-title">Let’s make it matter.</h2>
      <p>Interested in a thoughtful exchange about design, products, or teams.</p>
    </div>
    <a class="contact-panel__link" href={sitePath("contact/")}>Contact page <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
